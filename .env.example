# --- LLM provider (OpenAI-compatible chat completions) -----------------------
# Gemini free tier (default). Get a key at https://aistudio.google.com/apikey
LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
LLM_API_KEY=
LLM_MODEL=gemini-3.8-flash
LLM_CLASSIFIER_MODEL=gemini-3.5-flash-lite
# Tried when the main model fails (overloaded, rate limited, unknown model). Leave empty for none.
LLM_FALLBACK_MODEL=

# Local (later): point the same adapter at Ollama and restart.
#   LLM_BASE_URL=http://localhost:11434/v1/
#   LLM_API_KEY=ollama
#   LLM_MODEL=qwen3:8b

# --- Platform ---------------------------------------------------------------
PORT=3001
DATABASE_PATH=./data/supops.db
# 32-byte key, base64. Generate: openssl rand -base64 32
SUPOPS_MASTER_KEY=
JWT_SECRET=
# Max concurrent agent runs. Keep at 1 on a free tier or a local model.
RUN_CONCURRENCY=1
# Restrict NEW accounts to these email domains (comma-separated). Empty = no
# restriction (default). For an internal, org-only deployment set e.g.:
#   AUTH_ALLOWED_EMAIL_DOMAIN=acme.com
AUTH_ALLOWED_EMAIL_DOMAIN=

# Other browser origins allowed to call the API (comma-separated). Empty = same
# origin only, which is all the built UI and `npm run dev` need. Example:
#   CORS_ORIGINS=https://ops-portal.example.com
CORS_ORIGINS=

# MCP servers that run as a local program (stdio) are started on this machine, so
# they are off unless set to 1. MCP servers over HTTP need no switch.
SUPOPS_MCP_STDIO=

# Database backups: SQLite's online backup, safe while SupOps runs. Every N hours
# (0 = off), the newest K kept. Default folder: next to the database, in backups/.
SUPOPS_BACKUP_EVERY_HOURS=24
SUPOPS_BACKUP_KEEP=7
SUPOPS_BACKUP_DIR=

# Shadow execution: before a script (run_script) runs on a target, SupOps detonates it
# in a throwaway sandbox and raises the risk from what it observed. Point this at the
# detonator service (apps/detonator), reachable only from the server. Unset = scripts
# are not detonated (the native dry-runs for other commands still apply).
SUPOPS_DETONATOR_URL=

# Target-side shadow execution: run a command on the target inside a copy-on-write
# sandbox (bubblewrap) and raise the risk from what it actually touches. OFF by default;
# set to "on" only after reviewing the isolation profile. Needs bwrap, overlayfs and
# strace on the targets.
SUPOPS_TARGET_SHADOW=

# Fail-closed sandbox gate: when a change could NOT be verified in a sandbox, block it
# instead of letting a (possibly mistaken) approval run it on real infrastructure. The
# sandbox absorbs a malicious payload's impact before the box does.
#   off      (default) -- raise-only, fail-open: the sandbox only escalates what it catches.
#   scripts            -- block an unverified run_script (needs the detonator to be useful).
#   prod               -- block any unverified non-read-only change on a production target.
#   all                -- block every unverified non-read-only change. Strict: without the
#                         target shadow, most commands have no sandbox to verify them, so
#                         this blocks most changes until a backend (detonator/shadow) is up.
SUPOPS_SANDBOX_GATE=

# Weaker models (small/fast tiers) can be thrown off by the extra prompt weight and
# in-run nudges the engine adds. Set these to "off" to restore the leaner, pre-upgrade
# behaviour for such models:
#   SUPOPS_PLAYBOOKS=off   -- don't inject the per-run domain playbooks
#   SUPOPS_SELFCHECK=off   -- don't inject the verify / stuck / pre-flight self-check nudges
SUPOPS_PLAYBOOKS=
SUPOPS_SELFCHECK=
