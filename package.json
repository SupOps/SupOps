{
  "name": "supops",
  "private": true,
  "license": "Apache-2.0",
  "author": "Ayush Maheshwari (https://github.com/Ayyush-Maheshwari)",
  "type": "module",
  "workspaces": [
    "packages/*",
    "apps/server",
    "apps/web"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "npm run dev --workspace=@supops/server & npm run dev --workspace=@supops/web",
    "dev:server": "npm run dev --workspace=@supops/server",
    "dev:web": "npm run dev --workspace=@supops/web",
    "db:generate": "npm run db:generate --workspace=@supops/db",
    "db:migrate": "npm run db:migrate --workspace=@supops/db",
    "seed": "npm run seed --workspace=@supops/server",
    "test": "node --test --experimental-strip-types \"packages/**/*.test.ts\" \"apps/**/*.test.ts\"",
    "typecheck": "tsc --noEmit -p packages/shared && tsc --noEmit -p packages/db && tsc --noEmit -p packages/core && tsc --noEmit -p packages/eval && tsc --noEmit -p apps/server && tsc --noEmit -p apps/web",
    "add-key": "npm run add-key --workspace=@supops/server --",
    "eval": "npm run eval --workspace=@supops/eval --"
  },
  "devDependencies": {
    "typescript": "^5.7.2",
    "tsx": "^4.19.2",
    "@types/node": "^22.10.2"
  }
}
